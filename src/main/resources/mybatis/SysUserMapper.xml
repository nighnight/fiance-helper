<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.finance.mapper.SysUserMapper">

    <select id="selectByUsername" resultType="com.finance.po.SysUser">
        SELECT * FROM sys_user WHERE username = #{username}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO sys_user (username, password, nickname, create_time, status)
        VALUES (#{username}, #{password}, #{nickname}, NOW(), 1)
    </insert>

</mapper>